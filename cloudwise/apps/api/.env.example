# The app connects as the unprivileged role db/init.sql creates, NOT the
# postgres superuser — that's what makes Postgres RLS (tenant isolation)
# actually bind. See db/init.sql for why.
DATABASE_URL=postgresql+psycopg://cloudwise_app:cloudwise_app_dev_password@localhost:5432/cloudwise

# From your Clerk dashboard's API Keys page (Configure -> API Keys):
#   CLERK_JWKS_URL is https://<your-frontend-api>/.well-known/jwks.json
#   CLERK_ISSUER is that same https://<your-frontend-api> origin
# Also enable Organizations in the Clerk dashboard, and add a custom session
# token claim (Sessions -> Customize session token):
#   {"email": "{{user.primary_email_address}}"}
# See app/clerk_auth.py for exactly which claims CloudWise reads.
CLERK_JWKS_URL=
CLERK_ISSUER=
