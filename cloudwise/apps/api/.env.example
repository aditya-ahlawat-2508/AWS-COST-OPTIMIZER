# The app connects as the unprivileged role db/init.sql creates, NOT the
# postgres superuser — that's what makes Postgres RLS (tenant isolation)
# actually bind. See db/init.sql for why.
DATABASE_URL=postgresql+psycopg://cloudwise_app:cloudwise_app_dev_password@localhost:5432/cloudwise

# From your Clerk dashboard's API Keys page (Configure -> API Keys):
#   CLERK_JWKS_URL is https://<your-frontend-api>/.well-known/jwks.json
#   CLERK_ISSUER is that same https://<your-frontend-api> origin
# Also enable Organizations in the Clerk dashboard, and add a custom session
# token claim (Sessions -> Customize session token):
#   {"email": "{{user.primary_email_address}}"}
# See app/clerk_auth.py for exactly which claims CloudWise reads.
CLERK_JWKS_URL=
CLERK_ISSUER=

# AI copilot (services/copilot). Without this set, POST /copilot/chat returns
# a clean 503 rather than failing — the rest of the API works fine without it.
ANTHROPIC_API_KEY=

# Billing (app/billing.py). Create the Starter/Growth prices in the Stripe
# dashboard first and paste their price_... ids below. STRIPE_WEBHOOK_SECRET
# comes from the webhook endpoint you register in the Stripe dashboard
# (Developers -> Webhooks), pointed at POST /billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Razorpay (INR customers). Plan ids come from the Razorpay dashboard
# (Subscriptions -> Plans); the webhook secret from Settings -> Webhooks,
# pointed at POST /billing/razorpay/webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
