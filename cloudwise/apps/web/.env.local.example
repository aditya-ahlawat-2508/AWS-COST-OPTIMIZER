# From your Clerk dashboard's API Keys page. Enable the Organizations
# feature too — the backend requires an active org_id on every session
# (see ../api/app/clerk_auth.py).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The FastAPI backend (cloudwise/apps/api), e.g. http://localhost:8000 in dev.
NEXT_PUBLIC_API_URL=http://localhost:8000
